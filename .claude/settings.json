{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.js"
  },
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./.vercel/**)",
      "Read(./package-lock.json)",
      "Read(./skills-lock.json)",
      "Read(./**/*.lock)",
      "Read(./tsconfig.tsbuildinfo)",
      "Read(./public/**/*.png)",
      "Read(./public/**/*.jpg)",
      "Read(./public/**/*.svg)",
      "Read(./public/**/*.ico)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
