{
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./.next/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./.vercel/**)",
      "Read(./package-lock.json)",
      "Read(./skills-lock.json)",
      "Read(./**/*.lock)",
      "Read(./tsconfig.tsbuildinfo)",
      "Read(./public/**/*.png)",
      "Read(./public/**/*.jpg)",
      "Read(./public/**/*.svg)",
      "Read(./public/**/*.ico)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.js"
  }
}
